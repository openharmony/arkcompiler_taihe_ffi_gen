@class
interface TestInterface {
    SetValueArrayInt(value: @valuearray Array<i32>);
    SetValueArrayDouble(value: @valuearray Array<f64>);
    SetValueArrayBoolean(value: @valuearray Array<bool>);

    GetValueArrayInt(): @valuearray Array<i32>;
    GetValueArrayDouble(): @valuearray Array<f64>;
    GetValueArrayBoolean(): @valuearray Array<bool>;
}

@ctor("TestInterface")
function NewTestInterface(): TestInterface;