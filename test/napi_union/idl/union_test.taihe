@class
struct Foo {
  a: i32;
  b: String;
}

@class
interface Bar {}

@ctor("Foo")
function makeFoo(a: i32, b: String): Foo;

@ctor("Bar")
function makeBar(): Bar;

union union_primitive {
  undefinedValue: @undefined unit;
  nullValue: @null unit;
  stringValue: String;
  numberValue: f64;
  booleanValue: bool;
  arrayValue: Array<i32>;
  mapValue: Map<i32, String>;
  setValue: Set<String>;
  int16arrayValue: @typedarray Array<i16>;
  int32arrayValue: @typedarray Array<i32>;
  arraybufferValue: @arraybuffer Array<u8>;
  bigintValue: @bigint Array<u64>;
  fooValue: Foo;
  barValue: Bar;
}

function printUnion(data: union_primitive): String;
function makeUnion(kind: String): union_primitive;
